# Managed Postgres connection string (Neon, Supabase, Vercel Postgres, …).
# Use the pooled/pgBouncer URL for serverless. Example (Neon):
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=""

# JWT signing secret — 32+ random bytes. Rotating it invalidates all sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Optional: override the default channel source (defaults to iptv-org all-countries).
# DEFAULT_PLAYLIST_URL="https://iptv-org.github.io/iptv/index.country.m3u"
